# BasedNews is a public repo. Commit code, docs, configs and the figures the docs link to.
# Never commit secrets, article text (A10), databases, or anything a command regenerates.
# Note: git has no inline comments — a "# ..." after a pattern becomes part of the pattern.

# --- Secrets (see .env.example) --------------------------------------------------
.env
.env.*
!.env.example
.envrc
*.pem
*.key

# --- OS and editors -----------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
.claude/settings.local.json

# --- Python / uv -----------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.ipynb_checkpoints/

# --- Data: private by policy (article text, A10); only small public configs are tracked ---
data/*
!data/.gitkeep
!data/outlets_template.json
# outlet registry: names, feed URLs, DNR reach
!data/outlets.json
# history crawl list: the 5 reference outlets of each of 41 countries
!data/history_outlets.json
# outlet self-references used to blind the judge
!data/outlet_aliases.json
# similarity thresholds per embedding model
!data/embedding_profiles.json
# labelled evaluation pairs: article ids and labels only, no text (E7, E7b, 2.3)
!data/eval/
*.sqlite
*.sqlite-*
*.db
*.db-*

# --- Logs and run output ---------------------------------------------------------------
*.log
logs/
.logs/
*.pid

# --- Reports: the ones docs link to are committed; local or regenerable variants are not ---
# large local review page
reports/pipeline_review.html
# analyses dry-run on simulated verdicts
reports/*_simulated.*
# sensitivity variants and raw curves (re-run the sim modules to regenerate)
reports/*7500k*
reports/e2_curves_*.json
reports/e3_country_*.gif

# --- Frontend (Angular) -------------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/.angular/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
# the export job's output for `ng serve` (pipeline/export/run.py); production uploads it to the site bucket
frontend/src/data/
# unused sensitivity variant of the animation (not loaded by the site)
frontend/src/assets/plane-frames-750k.json

# --- Old Spring Boot build output (backend removed, ADR-010) -----------------------------------
backend/target/

# --- Infrastructure (Terraform, ADR-010); keep .terraform.lock.hcl ---------------------------
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
infra/main/.build/

# --- Design prototypes: real judge outputs stay local until publishing examples is decided --------------------
frontend/prototypes/judgments.json
frontend/prototypes/pilot-trends.json
